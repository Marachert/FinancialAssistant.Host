{
  "schemaVersion": 1,
  "planId": "ai-ocr-integration-test-plan-v1",
  "jiraIssueKey": "FIN-123",
  "releaseReadinessIssueKey": "FIN-124",
  "fixturePolicy": "generated_synthetic_only_no_real_or_provider_captured_data",
