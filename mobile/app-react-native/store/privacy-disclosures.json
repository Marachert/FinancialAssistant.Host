  "ownerReviewRequired": [
    "Reconcile disclosures against the exact production backend, native manifest, and every enabled third-party SDK.",
    "Confirm retention and deletion periods with the release owner before any public store release.",
    "Update both stores whenever data collection, sharing, SDKs, AI/OCR providers, or notification delivery changes."
  ]
