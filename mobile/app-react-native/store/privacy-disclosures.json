      "linkedToUser": true,
      "tracking": false,
      "purposes": ["App Functionality", "Account Management"]
    },
    {
      "dataType": "Other Financial Info",
      "linkedToUser": true,
      "tracking": false,
      "purposes": ["App Functionality"]
    },
    {
      "dataType": "Photos or Videos",
      "linkedToUser": true,
      "tracking": false,
      "purposes": ["App Functionality"]
    },
    {
      "dataType": "Other User Content",
      "linkedToUser": true,
      "tracking": false,
      "purposes": ["App Functionality"]
    }
