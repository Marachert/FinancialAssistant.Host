{
  "expo": {
    "name": "Financial Assistant",
    "slug": "financial-assistant",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "financialassistant",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.financialassistant.mobile",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.financialassistant.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F8F7"
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Financial Assistant to protect your signed-in session."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Financial Assistant to photograph a receipt you choose to review and upload.",
          "photosPermission": "Allow Financial Assistant to select a receipt image you choose to review and upload.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
