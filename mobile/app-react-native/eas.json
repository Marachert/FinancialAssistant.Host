{
  "$schema": "https://expo.dev/eas-json/schema.json",
  "cli": {
    "version": "22.4.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "production": {
      "distribution": "store",
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {}
    }
  }
}
