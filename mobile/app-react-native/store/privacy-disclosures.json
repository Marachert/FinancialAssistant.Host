  "googlePlay": [
    {
      "category": "Personal info",
      "dataType": "Email address",
      "collected": true,
      "shared": false,
      "required": true,
      "purposes": ["App functionality", "Account management"]
    },
    {
      "category": "Financial info",
      "dataType": "Purchase history and other financial information",
      "collected": true,
