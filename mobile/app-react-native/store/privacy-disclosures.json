      "required": true,
      "purposes": ["App functionality"]
    },
    {
      "category": "Photos and videos",
      "dataType": "Photos",
      "collected": true,
      "shared": false,
      "required": false,
      "purposes": ["App functionality"]
    },
    {
      "category": "App activity",
      "dataType": "Other user-generated content and app interactions",
      "collected": true,
      "shared": false,
      "required": true,
      "purposes": ["App functionality"]
    }
