# Copy to .env.poc and replace every REQUIRED_ value before validation.
# This file contains no usable credentials and is safe to commit.

COMPOSE_PROJECT_NAME=financial-assistant-poc
POC_HTTP_PORT=8080
NGINX_IMAGE=nginx:1.27.1-alpine
ALPINE_IMAGE=alpine:3.20.3

POSTGRES_IMAGE=postgres:16.4-alpine
POSTGRES_DATABASE=financial_assistant
POSTGRES_USER=fa_poc
POSTGRES_PASSWORD=REQUIRED_POSTGRES_PASSWORD

ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.15.3
ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
ELASTICSEARCH_HOST_PORT=9200

RABBITMQ_IMAGE=rabbitmq:3.13.7-management-alpine
RABBITMQ_USER=fa_poc
RABBITMQ_PASSWORD=REQUIRED_RABBITMQ_PASSWORD
RABBITMQ_VHOST=fa-poc
RABBITMQ_MANAGEMENT_PORT=15672

REDIS_IMAGE=redis:7.4.0-alpine
REDIS_PASSWORD=REQUIRED_REDIS_PASSWORD

MINIO_IMAGE=minio/minio:RELEASE.2024-08-17T01-24-54Z
MINIO_ROOT_USER=fa_poc_minio
MINIO_ROOT_PASSWORD=REQUIRED_MINIO_ROOT_PASSWORD
MINIO_CONSOLE_PORT=9001

PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
PROMETHEUS_PORT=9090
GRAFANA_IMAGE=grafana/grafana:11.2.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=fa_poc_admin
GRAFANA_ADMIN_PASSWORD=REQUIRED_GRAFANA_ADMIN_PASSWORD

IDENTITY_LOOKUP_HMAC_KEY=REQUIRED_32_BYTE_IDENTITY_LOOKUP_HMAC_KEY
IDENTITY_REFRESH_TOKEN_HASH_KEY=REQUIRED_32_BYTE_REFRESH_TOKEN_HASH_KEY
IDENTITY_ACCESS_TOKEN_SIGNING_KEY=REQUIRED_32_BYTE_ACCESS_TOKEN_SIGNING_KEY
IDENTITY_PROVIDER_HMAC_KEY=REQUIRED_32_BYTE_PROVIDER_HMAC_KEY
IDENTITY_EVENT_USER_HMAC_KEY=REQUIRED_32_BYTE_EVENT_USER_HMAC_KEY
INTERNAL_GATEWAY_SHARED_SECRET=REQUIRED_32_BYTE_GATEWAY_SHARED_SECRET
INTERNAL_SERVICE_SHARED_SECRET=REQUIRED_32_BYTE_SERVICE_SHARED_SECRET
RECEIPT_EVENT_SHARED_SECRET=REQUIRED_32_BYTE_RECEIPT_EVENT_SHARED_SECRET
MONITORING_SIGNAL_SHARED_SECRET=REQUIRED_32_BYTE_MONITORING_SIGNAL_SHARED_SECRET
MCP_SHARED_SECRET=REQUIRED_32_BYTE_MCP_SHARED_SECRET
