{
  "expo": {
    "name": "Financial Assistant",
    "slug": "financial-assistant",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "financialassistant",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.financialassistant.mobile"
    },
    "android": {
      "package": "com.financialassistant.mobile"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Financial Assistant to protect your signed-in session."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
